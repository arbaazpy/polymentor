# PolyMentor environment — copy to .env and fill in. NEVER commit .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-prod
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated; include your deployed host in prod, e.g. https://polymentor.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Database ---
# Dev defaults to SQLite when DATABASE_URL is unset.
# DATABASE_URL=postgres://user:pass@host:5432/polymentor

# --- Redis / Celery ---
# Dev runs Celery eager (synchronous) when CELERY_TASK_ALWAYS_EAGER=true.
CELERY_TASK_ALWAYS_EAGER=true
# REDIS_URL=redis://localhost:6379/0

# --- Nugen ---
NUGEN_API_KEY=
NUGEN_BASE_URL=https://api.nugen.in
# Default base model for smoke tests before experts are aligned/deployed.
NUGEN_DEFAULT_MODEL=
# Daily spend cap guard (USD) for re-alignment jobs.
NUGEN_DAILY_SPEND_USD=12

# --- Admin ---
# Bearer token for POST /v1/admin/mine.
ADMIN_BEARER_TOKEN=change-me

# --- Abuse controls ---
TURN_RATE_LIMIT=6
TURN_RATE_WINDOW_MINUTES=10
DAILY_TURN_CAP=200
MAX_PROMPT_CHARS=1500

# --- Production only ---
# DJANGO_SSL_REDIRECT=true
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=
